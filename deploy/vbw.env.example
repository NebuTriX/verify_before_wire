# Copy to deploy/vbw.env. Pick the block for your cloud.
DATABASE_URL=postgresql+asyncpg://vbw:CHANGE_ME@db:5432/vbw
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com

# --- Gemini, option A (recommended): your own Google Cloud project, no stored keys -----------
# From AWS or Azure, use Workload Identity Federation: create a credential config with
#   gcloud iam workload-identity-pools create-cred-config ... --aws (or --azure) --output-file=wif.json
# mount it into the container and point to it:
GEMINI_MODE=vertex
GEMINI_PROJECT=your-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/wif.json
# --- Gemini, option B: an API key (e.g. one supplied by the vendor). Text leaves your cloud. ---
# GEMINI_MODE=api_key
# GEMINI_API_KEY=...
GEMINI_REDACT=true

# --- File storage on a cloud instead of local disk --------------------------------------------
# AWS:   BLOB_BACKEND=s3    UPLOADS_BUCKET=my-bucket  S3_KMS_KEY_ID=arn:aws:kms:...   (instance role)
# Azure: BLOB_BACKEND=azure UPLOADS_BUCKET=container  AZURE_BLOB_ACCOUNT_URL=https://acct.blob.core.windows.net (managed identity)
OPENSANCTIONS_API_KEY=
DEMO_ENABLED=false
