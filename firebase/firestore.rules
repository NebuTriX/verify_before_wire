rules_version = '2';
// Browsers never read or write Firestore directly. Every request goes through the Verify-Before-Wire
// API on Cloud Run, which checks the signed-in user's role in each workspace and writes with its own
// service account (server access is not subject to these rules). So clients get nothing here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
