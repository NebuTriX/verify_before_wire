# Local development. Copy to backend/.env (gitignored) and fill in. Full guide: docs/firebase-setup.md
# Check the result with: python scripts/firebase_check.py

# --- Storage: PostgreSQL (docker compose -f docker-compose.dev.yml up -d) or Firestore -------------
STORE_BACKEND=sql
DATABASE_URL=postgresql+asyncpg://vbw:vbw_dev_only@127.0.0.1:5433/vbw
BLOB_BACKEND=file
BLOB_DIR=./data/blobs
# STORE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repo/service-account.json

# --- Sign-in: dev (any email) or firebase -----------------------------------------------------------
AUTH_MODE=dev
ALLOW_DEV_AUTH=true
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=web-app-apiKey-from-firebase-console      # public; never reuse it for Gemini

# --- Gemini: AI Studio key, or Vertex AI on your project (no prepaid credits) ----------------------
GEMINI_MODE=api_key
GEMINI_API_KEY=
# GEMINI_MODE=vertex
# GEMINI_PROJECT=your-project-id

# --- Optional: real phone calls for AI verification calls (else they run in the browser) -----------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+6531234567
# PUBLIC_BASE_URL=https://your-public-url        # Twilio must reach /api/telephony/...

DEMO_ENABLED=true
RATE_LIMIT_PER_MINUTE=6000
WEBHOOK_ALLOW_INSECURE=true      # local only: lets webhooks reach http://localhost
